rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isReception() {
      return hasRole('reception');
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() in ['admin', 'reception', 'doctor'];
    }

    function roleIsUnchanged() {
      return !('role' in request.resource.data) ||
             request.resource.data.role == resource.data.role;
    }

    function newUserIsPatient() {
      return request.resource.data.role == 'patient';
    }

    /// Reads clinic settings to check if booking is currently open.
    /// This makes isBookingOpen a SERVER-SIDE enforced check.
    function isBookingOpen() {
      let settings = get(/databases/$(database)/documents/settings/clinic_settings);
      return settings.data.isBookingOpen == true;
    }

    // =========================================================================
    // USERS
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) && newUserIsPatient();
      allow update: if (isOwner(userId) && roleIsUnchanged()) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // PATIENTS
    // =========================================================================
    match /patients/{patientId} {
      allow read: if isAuthenticated() &&
                    (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid ||
                       isReception() || isAdmin());
      allow update: if isAuthenticated() &&
                      (resource.data.userId == request.auth.uid ||
                       isReception() || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // DOCTORS
    // =========================================================================
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // APPOINTMENTS
    // =========================================================================
    match /appointments/{appointmentId} {
      // Read: own appointments or staff
      allow read: if isAuthenticated() &&
                    (resource.data.patientId == request.auth.uid || isStaff());

      // Create: patient books for themselves (isBookingOpen enforced server-side)
      //         Reception/Admin can book for any patient
      allow create: if isAuthenticated() && (
        (request.resource.data.patientId == request.auth.uid && isBookingOpen()) ||
        isReception() || isAdmin()
      );

      // Update: patient can cancel own (only 'cancelled' or 'arrived' → 'cancelled')
      //         Staff can update any
      allow update: if isAuthenticated() &&
                      (resource.data.patientId == request.auth.uid || isStaff());

      allow delete: if isAdmin();
    }

    // =========================================================================
    // TOKEN COUNTERS
    // Per-day, per-doctor atomic token number counters.
    // Document ID: {doctorId}_{YYYY-MM-DD}
    //
    // SECURITY NOTE: Authenticated patients need write access so the client-side
    // Firestore transaction can atomically increment the counter. Firestore
    // transaction guarantees atomicity (both reads validate at commit time).
    // A malicious patient could theoretically corrupt the counter by writing
    // outside a transaction — this is a UX risk (token numbering disruption)
    // but NOT a security risk (no privilege escalation). Full hardening requires
    // Cloud Functions (Phase 3B).
    // =========================================================================
    match /tokenCounters/{counterId} {
      // Any authenticated user can read their token number after booking
      allow read: if isAuthenticated();
      // Any authenticated user can write (needed for booking transaction)
      // TODO Phase 3B: Restrict to Cloud Functions only
      allow write: if isAuthenticated();
    }

    // =========================================================================
    // BOOKING LOCKS
    // Prevents duplicate bookings per patient/doctor/date.
    // Document ID: {patientId}_{doctorId}_{YYYY-MM-DD}
    //
    // SECURITY MODEL:
    // - Patient CREATE own lock (enforced: patientId == auth.uid, isBookingOpen)
    // - Patient UPDATE own lock ONLY to 'cancelled' status (cancellation flow)
    //   → Prevents patient from resetting their own lock to book again fraudulently
    // - Patient CANNOT DELETE their own lock (would bypass duplicate check)
    // - Staff can UPDATE any lock (e.g., marking noShow)
    // - Admin can DELETE locks (cleanup / fault recovery)
    // =========================================================================
    match /bookingLocks/{lockId} {
      // Patient can read own lock; staff can read any
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || isStaff()
      );

      // Patient can create own lock only when booking is open
      allow create: if isAuthenticated() &&
                      request.resource.data.patientId == request.auth.uid &&
                      isBookingOpen();

      // Patient can update own lock only to set status='cancelled'
      // Staff can update any lock
      allow update: if isAuthenticated() && (
        (resource.data.patientId == request.auth.uid &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        isStaff()
      );

      // Only admin can delete (fault recovery only)
      allow delete: if isAdmin();
    }

    // =========================================================================
    // QUEUE
    // =========================================================================
    match /queue/{queueId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // =========================================================================
    // SETTINGS
    // =========================================================================
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // EMPLOYEES
    // =========================================================================
    match /employees/{employeeId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // =========================================================================
    // HOLIDAYS
    // =========================================================================
    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAuthenticated() &&
                      (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
